# ==============================================================================
# REMIVAULT - ANDROID PRODUCTION SIGNING CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `keystore.properties` in this directory:
#   cp keystore.properties.example keystore.properties
# 
# WARNING: NEVER commit `keystore.properties` or `*.keystore` files to Git.
# They are ignored by .gitignore to protect your signing certificate.
# ==============================================================================

storeFile=remivault-release.keystore
storePassword=YOUR_KEYSTORE_PASSWORD_HERE
keyAlias=remivault
keyPassword=YOUR_KEY_PASSWORD_HERE

