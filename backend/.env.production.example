# ==============================================================================
# REMIVAULT - OFFICIAL PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Use this template for live deployment. 
# Copy to `.env` on your production server: cp .env.production.example .env
# Never commit real production `.env` files with secret keys to Git.
# ==============================================================================

# Core Application Settings
APP_NAME=RemiVault
APP_ENV=production
APP_DEBUG=false
APP_URL=https://remivault.app
FRONTEND_URL=https://remivault.app

# 32-character base64 application key. Generate on production using: php artisan key:generate
# CRITICAL: Always back up this key! Vault passwords and encrypted records are encrypted
# using AES-256 with this key. If lost, encrypted user data is permanently unrecoverable.
APP_KEY=

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Security & Password Hashing
BCRYPT_ROUNDS=12

# Production Logging (Warning level prevents storage drive overflow from debug logs)
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Production MySQL / MariaDB Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remivault_prod
DB_USERNAME=remivault_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_COLLATION=utf8mb4_unicode_ci

# Production Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Production Cache & Queue
CACHE_STORE=database
CACHE_PREFIX=remivault_cache
QUEUE_CONNECTION=database

# Cross-Origin Resource Sharing (CORS) Production Lockdown
# Comma-separated list of exact production domains allowed to call the API
CORS_ALLOWED_ORIGINS="https://remivault.app,https://api.remivault.app,capacitor://localhost"

# Laravel Sanctum Stateful Domains & Token Expiration
# Token expiration in minutes (e.g. 43200 = 30 days). Leave blank for non-expiring tokens.
SANCTUM_STATEFUL_DOMAINS="remivault.app,api.remivault.app"
SANCTUM_TOKEN_EXPIRATION=43200

# Professional Transactional Email Relay (Brevo / Sendinblue SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_BREVO_LOGIN_LOGIN_HERE
MAIL_PASSWORD=YOUR_BREVO_SMTP_MASTER_KEY_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@remivault.app"
MAIL_FROM_NAME="RemiVault Security"

# Super Administrator Console
# Change this 4-digit PIN to a unique secret PIN before going live!
ADMIN_MASTER_PIN=9842
ADMIN_EMAIL=admin@remivault.app

